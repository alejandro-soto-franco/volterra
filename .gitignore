/target
Cargo.lock
.worktrees/
.venv/
output/
literature/
examples/
tools/viz/

# AI tooling

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Keep volterra-braid demos (override the blanket examples/ ignore)
!volterra-braid/examples/
!volterra-braid/examples/**

# The confined-domain driver and the field replay are part of the published
# workflow, and the changelog and READMEs refer to them, so they are tracked.
# The dbg_* examples stay ignored: they are scratch for one investigation each.
!volterra-dec/examples/
!volterra-dec/examples/active_confined.rs
!volterra-dec/examples/replay_fields.rs
volterra-dec/examples/dbg_*.rs

# The drivers and the figure and film scripts a reader needs to reproduce a
# published run. The remaining volterra-fd examples stay ignored: each is
# scratch for one comparison.
!volterra-fd/examples/
volterra-fd/examples/*
!volterra-fd/examples/periodic_active_nematic.rs
!volterra-fd/examples/analyse_periodic.py
!volterra-fd/examples/plot_periodic.py
!volterra-fd/examples/panels_periodic_video.py
!volterra-fd/examples/braid_report.rs
!volterra-fd/examples/plot_braid.py
!volterra-fd/examples/plot_fig5.py
!volterra-fd/examples/plot_paper_figures.py

# The sphere family: the scaling fit across runs, and the film of one run.
# sphere_panels.py stays ignored, being a still of a single frame.
!volterra-fd/examples/sphere_scaling.py
!volterra-fd/examples/sphere_braid_video.py
!volterra-fd/examples/video_library.py

# Generated CGPO reference runner (regenerate via patch_flow_solver.py) + IC dumps
volterra-braid/oracle/concurrence/flow_solver_run.py
theta_ic_*.txt
als_*_ncl_*/

# maturin / packaging build output
dist/
uv.lock
