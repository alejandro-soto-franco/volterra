# AI tooling

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Keep volterra-braid demos (override the blanket examples/ ignore)
!volterra-braid/examples/
!volterra-braid/examples/**

# The confined-domain driver and the field replay are part of the published
# workflow, and the changelog and READMEs refer to them, so they are tracked.
# The dbg_* examples stay ignored: they are scratch for one investigation each.
!volterra-dec/examples/
!volterra-dec/examples/active_confined.rs
!volterra-dec/examples/replay_fields.rs
volterra-dec/examples/dbg_*.rs

# Generated CGPO reference runner (regenerate via patch_flow_solver.py) + IC dumps
volterra-braid/oracle/concurrence/flow_solver_run.py
theta_ic_*.txt
als_*_ncl_*/

